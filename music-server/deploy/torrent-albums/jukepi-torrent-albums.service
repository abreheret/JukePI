[Unit]
Description=Copy finished MP3 torrents into the music library and rescan
After=mnt-music.mount music-server.service

[Service]
Type=oneshot
# Adjust: user that owns the music library; paths can be overridden in the environment file.
User=pi
EnvironmentFile=-/etc/music-server/torrent-albums.env
ExecStart=/usr/local/bin/jukepi-import-torrent-albums
